<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Personal Expense Tracker</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <header class="app-header">
    <h1>💰 Personal Expense Tracker</h1>
    <p>Track your income and expenses, and know where your money goes.</p>
  </header>

  <main class="container">
    <!-- Summary cards -->
    <section class="summary" aria-label="Summary">
      <div class="card balance"><span>Balance</span><strong id="balance">₹0.00</strong></div>
      <div class="card income"><span>Total Income</span><strong id="income">₹0.00</strong></div>
      <div class="card expense"><span>Total Expense</span><strong id="expense">₹0.00</strong></div>
    </section>

    <div class="grid">
      <!-- Add transaction form -->
      <section class="panel">
        <h2>Add Transaction</h2>
        <form id="txForm" novalidate>
              <option value="all">All</option>
              <option value="income">Income</option>
              <option value="expense">Expense</option>
            </select>
            <select id="filterCategory" aria-label="Filter by category">
              <option value="all">All categories</option>
            </select>
          </div>
        </div>
        <ul id="list" class="list"></ul>
        <p id="empty" class="empty">No transactions yet. Add your first one!</p>
        <button id="clearAll" class="btn-danger">Clear All</button>
      </section>
    </div>

    <!-- Category breakdown -->
    <section class="panel">
      <h2>Expense by Category</h2>
      <div id="breakdown" class="breakdown"></div>
    </section>
  </main>

  <footer>Personal Expense Tracker · HTML · CSS · JavaScript</footer>
  <script src="script.js"></script>
</body>
</html>
